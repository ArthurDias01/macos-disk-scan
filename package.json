{
  "name": "disk-report",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "macOS disk usage scanner with a TanStack Start SPA for exploring what is eating storage",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun run build:embed",
    "scan": "go run ./cmd/scan",
    "test": "bun test && go test ./...",
    "typecheck": "tsc --noEmit",
    "gen": "bun run gen:types && bun run gen:config",
    "gen:types": "bun run tools/gen-go-types.ts",
    "gen:config": "bun run tools/gen-go-config.ts",
    "gen:check": "bun run gen && git diff --exit-code internal/schema/schema_gen.go internal/config/defaults.json",
    "go:test": "go test ./internal/...",
    "go:build": "go build -o bin/scan ./cmd/scan",
    "parity": "bun run tools/parity.ts",
    "serve": "go run ./cmd/scan serve",
    "gen:icons": "bun run tools/gen-icons.ts",
    "build:embed": "bun run tools/embed-ui.ts"
  },
  "dependencies": {
    "@tanstack/charts": "0.14.0",
    "@tanstack/react-charts": "0.14.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
